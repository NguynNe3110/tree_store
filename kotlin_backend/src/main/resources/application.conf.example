# Tree Store Backend Configuration Template
# Copy this file to application.conf and replace the placeholders with your actual values.

ktor {
    deployment {
        port = 8081
        port = ${?PORT}
    }
    application {
        modules = [ com.treestore.ApplicationKt.module ]
    }
}

db {
    # Default local PostgreSQL connection
    jdbcUrl = "jdbc:postgresql://localhost:5432/tree_store_db"
    jdbcUrl = ${?DB_JDBC_URL}

    driverClassName = "org.postgresql.Driver"

    user = "your_db_user"
    user = ${?DB_USER}

    password = "your_db_password"
    password = ${?DB_PASSWORD}

    maximumPoolSize = 10
}

jwt {
    # Replace with a long random string for production
    secret = "your_jwt_secret_key_at_least_256_bits_long"
    secret = ${?JWT_SECRET}

    issuer = "tree-store-backend"
    audience = "tree-store-app"
    realm = "tree-store"
    accessTokenTtlMinutes = 15
    refreshTokenTtlDays = 7
}

smtp {
    # Example using Gmail SMTP
    host = "smtp.gmail.com"
    host = ${?SMTP_HOST}

    port = 587
    port = ${?SMTP_PORT}

    user = "your_email@gmail.com"
    user = ${?SMTP_USER}

    password = "your_app_password"
    password = ${?SMTP_PASS}

    from = "your_email@gmail.com"
    from = ${?SMTP_FROM}
}

admin {
    # Default admin credentials for the dashboard
    username = "admin"
    username = ${?ADMIN_USER}

    password = "admin_password"
    password = ${?ADMIN_PASS}
}

payment {
    # The public URL of your backend (required for payment webhooks)
    # Use your server IP or domain in production.
    publicBaseUrl = "http://localhost:8081"
    publicBaseUrl = ${?PAYMENT_PUBLIC_BASE_URL}

    payos {
        baseUrl = "https://api.payos.vn"
        baseUrl = ${?PAYOS_BASE_URL}

        clientId = "your_payos_client_id"
        clientId = ${?PAYOS_CLIENT_ID}

        checksumSecret = "your_payos_checksum_secret"
        checksumSecret = ${?PAYOS_CHECKSUM_SECRET}

        secretKey = "your_payos_secret_key"
        secretKey = ${?PAYOS_SECRET_KEY}
    }
}